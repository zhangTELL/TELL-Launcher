<Window x:Class="TELLLauncher.Views.SteamLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TELLLauncher.ViewModels"
        Title="Steam 游戏库"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1F2937">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="#1B2838">
                        <TextBlock Text="S"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                    <TextBlock Text="Steam 游戏库"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           x:Name="CountText"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="#6B7280" />
                <Button Grid.Column="2"
                        Content="刷新"
                        Width="80"
                        Padding="0,7"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GameList"
                              Margin="20,16,20,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SteamGameItemViewModel}">
                            <Button Width="200"
                                    Height="96"
                                    Margin="8"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    Click="GameCard_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Card"
                                                Width="200"
                                                Height="96"
                                                Margin="8"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid Margin="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42"
                                                        Height="42"
                                                        CornerRadius="8"
                                                        Background="#E8EEF7">
                                                    <TextBlock Text="{Binding Initial}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="#2563EB" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AppId, StringFormat=AppID {0}}"
                                                               Margin="0,5,0,0"
                                                               FontSize="12"
                                                               Foreground="#6B7280" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#BFDBFE" />
                                                <Setter TargetName="Card" Property="Background" Value="#F8FAFF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="#EFF6FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText"
                       Text="未找到已安装的 Steam 游戏"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="#9CA3AF"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
