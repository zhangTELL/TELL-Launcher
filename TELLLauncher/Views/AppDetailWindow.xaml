<Window x:Class="TELLLauncher.Views.AppDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用详情"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="260" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- 顶部横幅区 -->
        <Grid Grid.Row="0"
              Background="#101822"
              ClipToBounds="True">
            <Image Source="{Binding DetailImageSource}"
                   Stretch="Uniform"
                   StretchDirection="Both"
                   Margin="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasDetailImage, Converter={StaticResource BoolToVis}}" />

            <!-- 无图回退：与卡片一致的渐变底 + 首字母，避免整条横幅发黑 -->
            <Border Visibility="{Binding HasNoDetailImage, Converter={StaticResource BoolToVis}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A475E" Offset="0" />
                        <GradientStop Color="#101822" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="72"
                            Height="72"
                            CornerRadius="10"
                            Background="#101822"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Initial}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="暂无页面图片"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 底部渐变信息条 -->
            <Border VerticalAlignment="Bottom"
                    Padding="24,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#F2171D25" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0">
                            <TextBlock Text="{Binding GroupDisplay}"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="  ·  "
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding LastLaunchedDisplay}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="▶ 启动"
                            Padding="22,10"
                            VerticalAlignment="Bottom"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="{StaticResource LaunchGreenBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LaunchButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 信息区 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,18">
                <TextBlock Text="程序路径"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <Grid Margin="0,6,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- steam:// 等协议地址翻译成动作说明，原始值放在工具提示里 -->
                    <TextBlock Text="{Binding TargetPathDisplay}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               ToolTip="{Binding TargetPath}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button x:Name="CopyPathButton"
                            Grid.Column="1"
                            Content="复制路径"
                            MinWidth="76"
                            Padding="10,5"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource DarkDialogButton}"
                            Visibility="{Binding HasTargetPath, Converter={StaticResource BoolToVis}}"
                            Click="CopyPathButton_Click" />
                </Grid>

                <TextBlock Text="详细信息"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <!-- 整个信息盒随详情一起隐藏：此前只藏内部文字，
                     空详情时留下一个 120px 的空框 + "暂无详细信息"双重空状态 -->
                <Border Margin="0,10,0,0"
                        Padding="14"
                        MinHeight="120"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Details}"
                               TextWrapping="Wrap"
                               Foreground="#C7D5E0" />
                </Border>
                <TextBlock Text="暂无详细信息"
                           Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding HasNoDetails, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <Button Content="编辑"
                        Width="88"
                        Padding="0,7"
                        Style="{StaticResource DarkDialogButton}"
                        Click="EditButton_Click" />
                <Button Content="关闭"
                        Width="88"
                        Padding="0,7"
                        Margin="8,0,0,0"
                        Style="{StaticResource DarkDialogButton}"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
