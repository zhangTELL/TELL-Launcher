<Window x:Class="TELLLauncher.Views.AppDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用详情"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="260" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- 顶部横幅区 -->
        <Grid Grid.Row="0"
              Background="#101822">
            <Image Source="{Binding DetailImageSource}"
                   Stretch="Uniform"
                   Visibility="{Binding HasDetailImage, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="暂无页面图片"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding HasNoDetailImage, Converter={StaticResource BoolToVis}}" />

            <!-- 底部渐变信息条 -->
            <Border VerticalAlignment="Bottom"
                    Padding="24,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#F2171D25" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding GroupDisplay}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="▶ 启动"
                            Padding="22,10"
                            VerticalAlignment="Bottom"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="{StaticResource LaunchGreenBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LaunchButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 信息区 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,18">
                <TextBlock Text="程序路径"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding TargetPath}"
                           Margin="0,6,0,18"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock Text="详细信息"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <Border Margin="0,10,0,0"
                        Padding="14"
                        MinHeight="120"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="{Binding Details}"
                               TextWrapping="Wrap"
                               Foreground="#C7D5E0"
                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                </Border>
                <TextBlock Text="暂无详细信息"
                           Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding HasNoDetails, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <Button Content="编辑"
                        Width="88"
                        Padding="0,7"
                        Style="{StaticResource DarkDialogButton}"
                        Click="EditButton_Click" />
                <Button Content="关闭"
                        Width="88"
                        Padding="0,7"
                        Margin="8,0,0,0"
                        Style="{StaticResource DarkDialogButton}"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
