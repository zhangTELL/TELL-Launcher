<Window x:Class="TELLLauncher.Views.AppDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用详情"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#1F2937">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="46"
                        Height="46"
                        CornerRadius="8"
                        Background="#E8EEF7"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initial}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"
                                   Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVis}}" />
                        <Image Source="{Binding Icon}"
                               Width="34"
                               Height="34"
                               Stretch="Uniform"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GroupDisplay}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="#6B7280" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Image Source="{Binding DetailImageSource}"
                           Margin="12"
                           Stretch="Uniform"
                           Visibility="{Binding HasDetailImage, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="暂无页面图片"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#9CA3AF"
                               Visibility="{Binding HasNoDetailImage, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="程序路径"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TargetPath}"
                               Margin="0,6,0,18"
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />

                    <TextBlock Text="详细信息"
                               FontWeight="SemiBold" />
                    <Border Margin="0,10,0,0"
                            Padding="12"
                            MinHeight="120"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Text="{Binding Details}"
                                   TextWrapping="Wrap"
                                   Foreground="#374151"
                                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                    </Border>
                    <TextBlock Text="暂无详细信息"
                               Margin="0,14,0,0"
                               Foreground="#9CA3AF"
                               Visibility="{Binding HasNoDetails, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <Button Content="编辑"
                        Width="88"
                        Padding="0,7"
                        Click="EditButton_Click" />
                <Button Content="关闭"
                        Width="88"
                        Padding="0,7"
                        Margin="8,0,0,0"
                        Click="CloseButton_Click" />
                <Button Content="启动"
                        Width="96"
                        Padding="0,7"
                        Margin="8,0,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderBrush="#2563EB"
                        Click="LaunchButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
