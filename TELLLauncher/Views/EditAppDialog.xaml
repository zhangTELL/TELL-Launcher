<Window x:Class="TELLLauncher.Views.EditAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="名称"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold" />
        <TextBox Grid.Row="1"
                 x:Name="NameTextBox"
                 Padding="8,6"
                 Margin="0,0,0,14"
                 Style="{StaticResource DarkTextBox}" />

        <TextBlock Grid.Row="2"
                   Text="程序路径"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathTextBox"
                     Padding="8,6"
                     Margin="0,0,8,0"
                     Style="{StaticResource DarkTextBox}" />
            <Button Grid.Column="1"
                    Content="浏览"
                    Padding="12,6"
                    Style="{StaticResource DarkDialogButton}"
                    Click="BrowseButton_Click" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="页面图片"
                   Margin="0,18,0,6"
                   FontWeight="SemiBold" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DetailImageTextBox"
                     Padding="8,6"
                     Margin="0,0,8,0"
                     Style="{StaticResource DarkTextBox}" />
            <Button Grid.Column="1"
                    Content="选择图片"
                    Padding="12,6"
                    Style="{StaticResource DarkDialogButton}"
                    Click="BrowseImageButton_Click" />
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="详细信息"
                   Margin="0,18,0,6"
                   FontWeight="SemiBold" />
        <TextBox Grid.Row="7"
                 x:Name="DetailsTextBox"
                 Height="120"
                 Padding="8,6"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource DarkTextBox}" />

        <Grid Grid.Row="8"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="GroupPanel">
                <TextBlock Text="分组"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="GroupComboBox"
                          Width="180"
                          HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <Button Content="取消"
                        Width="80"
                        Padding="0,7"
                        Margin="0,0,8,0"
                        Style="{StaticResource DarkDialogButton}"
                        Click="CancelButton_Click" />
                <Button Content="确定"
                        Width="80"
                        Padding="0,7"
                        IsDefault="True"
                        Style="{StaticResource DarkDialogButton}"
                        Click="OkButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
