<Window x:Class="TELLLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TELLLauncher.ViewModels"
        mc:Ignorable="d"
        Title="TELL Launcher"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="4"
                            Background="Transparent">
                        <Image Source="pack://application:,,,/app.png"
                               Width="32"
                               Height="32"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="TELL Launcher"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Width="420"
                      MaxWidth="420"
                      Margin="16,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <TextBox Padding="28,7,32,7"
                             VerticalAlignment="Center"
                             BorderBrush="#3D4450"
                             Background="#101822"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape"
                                        Command="{Binding ClearSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsHitTestVisible="False" />
                    <TextBlock Text="搜索应用或游戏"
                               Margin="28,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVis}}" />
                    <Button HorizontalAlignment="Right"
                            Margin="0,0,6,0"
                            Content="&#xE711;"
                            Style="{StaticResource SearchClearButton}"
                            ToolTip="清除搜索（Esc）"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding IsNotSearchEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- 普通模式：刷新/添加/管理 -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsNotManaging, Converter={StaticResource BoolToVis}}">
                        <Button Content="&#xE72C;"
                                Style="{StaticResource IconButton}"
                                ToolTip="刷新桌面游戏"
                                Click="RefreshButton_Click" />
                        <Button Content="&#xE710;"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButton}"
                                ToolTip="添加应用"
                                Click="AddButton_Click" />
                        <Button Content="&#xE713;"
                                Margin="8,0,0,0"
                                Style="{StaticResource IconButton}"
                                ToolTip="管理"
                                Click="ManageButton_Click" />
                    </StackPanel>
                    <!-- 管理模式：取消/确定 -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsManaging, Converter={StaticResource BoolToVis}}">
                        <Button Content="取消"
                                Width="72"
                                Padding="0,7"
                                Style="{StaticResource DarkDialogButton}"
                                Click="ManageButton_Click" />
                        <Button Content="确定"
                                Width="72"
                                Padding="0,7"
                                Margin="8,0,0,0"
                                Style="{StaticResource DarkDialogButton}"
                                Click="ManageButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：侧边栏 + 内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏导航 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="办公"
                               Margin="20,0,0,6"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button Command="{Binding SelectNavCommand}"
                            CommandParameter="{x:Static vm:NavSection.Ide}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}"
                                                 Value="{x:Static vm:NavSection.Ide}">
                                        <Setter Property="Tag" Value="Selected" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="IDE"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectNavCommand}"
                            CommandParameter="{x:Static vm:NavSection.AiTool}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}"
                                                 Value="{x:Static vm:NavSection.AiTool}">
                                        <Setter Property="Tag" Value="Selected" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE99A;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="AI 工具"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="游戏"
                               Margin="20,18,0,6"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button Command="{Binding SelectNavCommand}"
                            CommandParameter="{x:Static vm:NavSection.Game}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}"
                                                 Value="{x:Static vm:NavSection.Game}">
                                        <Setter Property="Tag" Value="Selected" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="全部游戏"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="最近"
                               Margin="20,18,0,6"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button Command="{Binding SelectNavCommand}"
                            CommandParameter="{x:Static vm:NavSection.Recent}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}"
                                                 Value="{x:Static vm:NavSection.Recent}">
                                        <Setter Property="Tag" Value="Selected" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="最近启动"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <!-- 切换导航时内容区淡入（Style 触发器不允许 TargetName，仅做透明度动画） -->
                            <DataTrigger Binding="{Binding SelectedNav}"
                                         Value="{x:Static vm:NavSection.Ide}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav}"
                                         Value="{x:Static vm:NavSection.AiTool}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav}"
                                         Value="{x:Static vm:NavSection.Game}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedNav}"
                                         Value="{x:Static vm:NavSection.Recent}">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="24,18,24,0">
                    <TextBlock x:Name="ContentTitleText"
                               Text="{Binding ContentTitle}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ContentSubtitle}"
                               Margin="12,0,0,2"
                               VerticalAlignment="Bottom"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- 管理模式提示条：说明当前可以拖拽排序 -->
                <Border Grid.Row="1"
                        Margin="24,10,24,0"
                        Padding="12,7"
                        CornerRadius="4"
                        Background="#16283E"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        Visibility="{Binding IsManaging, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="管理模式：拖拽卡片调整顺序，或用卡片右上角的按钮编辑与移除"
                               FontSize="12"
                               Foreground="#93C5FD" />
                </Border>

                <!-- 加载骨架屏 -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <!-- 横版骨架：IDE / AI 工具 / 最近启动 -->
                    <WrapPanel Margin="16,18,16,24">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}"
                                                 Value="{x:Static vm:NavSection.Game}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <Border Style="{StaticResource SkeletonOfficeCard}" />
                        <Border Style="{StaticResource SkeletonOfficeCard}" />
                        <Border Style="{StaticResource SkeletonOfficeCard}" />
                        <Border Style="{StaticResource SkeletonOfficeCard}" />
                        <Border Style="{StaticResource SkeletonOfficeCard}" />
                        <Border Style="{StaticResource SkeletonOfficeCard}" />
                    </WrapPanel>

                    <!-- 竖版骨架：游戏 -->
                    <WrapPanel Margin="16,18,16,24">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNav}"
                                                 Value="{x:Static vm:NavSection.Game}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                        <Border Style="{StaticResource SkeletonGameCard}" />
                    </WrapPanel>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <!-- 必须继承隐式样式：本地 Style 会整个覆盖 App.xaml 里的
                             暗色滚动条模板，漏掉 BasedOn 滚动条就会变回系统亮色 -->
                        <Style TargetType="ScrollViewer"
                               BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ListBox x:Name="AppListBox"
                             ItemsSource="{Binding CurrentApps}"
                             Margin="16,10,16,24"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ListBox_PreviewMouseMove"
                             PreviewMouseWheel="ListBox_PreviewMouseWheel"
                             DragOver="ListBox_DragOver"
                             Drop="ListBox_Drop">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <!-- 边框始终占 2px、只切换颜色：若等到聚焦时才加厚度，
                                     卡片会在键盘导航时逐格位移 -->
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- 必须整体替换系统模板：系统 ListBoxItem 模板自带
                                             "悬停画高亮蓝边框"的触发器，且模板触发器优先级
                                             高于样式值，仅在样式里改 BorderBrush 压不住 -->
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsFocused" Value="True">
                                                    <!-- 键盘导航的焦点环用中性灰：
                                                         强调蓝会被误读成悬停高亮 -->
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3D4450" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- 管理模式下切换为抓手光标，让"可拖拽"被看见 -->
                                    <DataTrigger Binding="{Binding DataContext.IsManaging, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="True">
                                        <Setter Property="Cursor" Value="SizeAll" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>

                <!-- 空状态：区分"当前分区为空"与"搜索无结果"，两者语义完全不同 -->
                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNoSearchResult}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="这里还空空如也"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="点击右上角 + 添加第一个应用"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Content="添加应用"
                                Margin="0,16,0,0"
                                Padding="18,8"
                                HorizontalAlignment="Center"
                                Style="{StaticResource DarkDialogButton}"
                                Click="AddButton_Click" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsNoSearchResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="未找到匹配的应用"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Content="清除搜索"
                                Margin="0,16,0,0"
                                Padding="18,8"
                                HorizontalAlignment="Center"
                                Style="{StaticResource DarkDialogButton}"
                                Command="{Binding ClearSearchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 通知条：按级别切换配色，此前只有一种警告色 -->
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="16,9"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#16283E" />
                    <Setter Property="BorderBrush" Value="#3B82F6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccessNotification}" Value="True">
                            <Setter Property="Background" Value="#14331F" />
                            <Setter Property="BorderBrush" Value="#22C55E" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWarningNotification}" Value="True">
                            <Setter Property="Background" Value="#3B2E14" />
                            <Setter Property="BorderBrush" Value="#F59E0B" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsErrorNotification}" Value="True">
                            <Setter Property="Background" Value="#3B1D1D" />
                            <Setter Property="BorderBrush" Value="#EF4444" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding NotificationText}"
                       FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#93C5FD" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessNotification}" Value="True">
                                <Setter Property="Foreground" Value="#86EFAC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWarningNotification}" Value="True">
                                <Setter Property="Foreground" Value="#FCD34D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsErrorNotification}" Value="True">
                                <Setter Property="Foreground" Value="#FCA5A5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- 状态栏：左侧状态文案，右侧扫描时间 + 刷新入口 -->
        <Border Grid.Row="2"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,1">
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastScanTimeDisplay}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Content="&#xE72C;"
                            Style="{StaticResource MiniIconButton}"
                            ToolTip="重新扫描桌面游戏"
                            Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
