<Window x:Class="TELLLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:TELLLauncher.Views"
        mc:Ignorable="d"
        Title="TELL 启动器"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="#1F2937">
                        <TextBlock Text="T"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                    <TextBlock Text="TELL 启动器"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBox Grid.Column="1"
                         Width="420"
                         MaxWidth="420"
                         Margin="16,0"
                         Padding="10,7"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         BorderBrush="{StaticResource CardBorderBrush}"
                         Background="#F9FAFB"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="&#xE72C;"
                            Style="{StaticResource IconButton}"
                            ToolTip="刷新桌面游戏"
                            Click="RefreshButton_Click" />
                    <Button Content="&#xE710;"
                            Margin="8,0,0,0"
                            Style="{StaticResource IconButton}"
                            ToolTip="添加应用"
                            Click="AddButton_Click" />
                    <Button Content="&#xE713;"
                            Margin="8,0,0,0"
                            Style="{StaticResource IconButton}"
                            ToolTip="管理"
                            Click="ManageButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="办公">
                <views:OfficeView />
            </TabItem>
            <TabItem Header="游戏">
                <views:GameView />
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="16,9"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                IsHitTestVisible="False"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding NotificationText}"
                       FontSize="13"
                       Foreground="#991B1B" />
        </Border>

        <Border Grid.Row="2"
                Background="#F9FAFB"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Margin="20,6"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
